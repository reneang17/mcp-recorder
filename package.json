{
  "name": "mcp-recorder",
  "version": "1.0.0",
  "description": "CDP Recording Engine - captures DOM events and network requests from Chrome via DevTools Protocol",
  "main": "dist/recorder.js",
  "types": "dist/recorder.d.ts",
  "bin": {
    "mcp-recorder": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "test:ci": "vitest run tests/unit/ tests/integration/",
    "cli": "npx tsx src/cli.ts"
  },
  "keywords": [
    "mcp",
    "chrome",
    "cdp",
    "recorder",
    "devtools"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/node": "^20.11.0",
    "puppeteer": "^24.40.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.2"
  }
}
